$mod = SUPER
$term = uwsm app -- foot
$menu = uwsm app -- rofi -show drun
$files = uwsm app -- pcmanfm-qt
$lock = hyprlock -c /etc/xdg/hypr/hyprlock.conf

monitor = , preferred, auto, 1
xwayland {
    # Avoid ugly interpolation by allowing X11 windows to scale themselves.
    force_zero_scaling = true
}

exec-once = hyprctl setcursor Adwaita 24

general {
    gaps_in = 0
    gaps_out = 0
    border_size = 4
    col.active_border = rgb(356859)
    col.inactive_border = rgb(20242b)
    layout = dwindle
    resize_on_border = true
}

animations {
    enabled = false
}

dwindle {
    # Split on the right or bottom
    force_split = 2
}

group {
    col.border_active = rgb(356859)
    col.border_inactive = rgb(20242b)
}

misc {
    disable_hyprland_logo = true
    disable_splash_rendering = true
    background_color = rgb(20242b)
}

input {
    # Get rid of this awful auto change focus crap.
    follow_mouse = 2
    float_switch_override_focus = 0
}

bind = $mod, RETURN, exec, $term
bind = $mod, D, exec, $menu
bind = ALT, SPACE, exec, $menu
bind = $mod SHIFT, Q, killactive
bind = $mod SHIFT, C, exec, hyprctl reload
bind = ALT, TAB, cyclenext
bind = ALT, TAB, bringactivetotop
bind = $mod, TAB, workspace, previous

# Managing new workspaces
bind = $mod, N, workspace, empty
bind = $mod SHIFT, N, movetoworkspacesilent, empty
bind = $mod SHIFT, M, movetoworkspace, empty

# Clipboard
bind = $mod SHIFT, P, exec, fleet-clipboard select
bind = $mod CTRL, P, exec, fleet-clipboard clear
bind = , PRINT, exec, grimblast copy area

# Selecting windows
bind = $mod, LEFT, movefocus, l
bind = $mod, DOWN, movefocus, d
bind = $mod, UP, movefocus, u
bind = $mod, RIGHT, movefocus, r
bind = $mod, H, movefocus, l
bind = $mod, J, movefocus, d
bind = $mod, K, movefocus, u
bind = $mod, L, movefocus, r

# Moving windows
bind = $mod SHIFT, LEFT, movewindow, l
bind = $mod SHIFT, DOWN, movewindow, d
bind = $mod SHIFT, UP, movewindow, u
bind = $mod SHIFT, RIGHT, movewindow, r
bind = $mod SHIFT, H, movewindow, l
bind = $mod SHIFT, J, movewindow, d
bind = $mod SHIFT, K, movewindow, u
bind = $mod SHIFT, L, movewindow, r

# Selecting workspaces
bind = $mod, 1, workspace, 1
bind = $mod, 2, workspace, 2
bind = $mod, 3, workspace, 3
bind = $mod, 4, workspace, 4
bind = $mod, 5, workspace, 5
bind = $mod, 6, workspace, 6
bind = $mod, 7, workspace, 7
bind = $mod, 8, workspace, 8
bind = $mod, 9, workspace, 9
bind = $mod, 0, workspace, 10

# Moving to workspaces
bind = $mod SHIFT, 1, movetoworkspacesilent, 1
bind = $mod SHIFT, 2, movetoworkspacesilent, 2
bind = $mod SHIFT, 3, movetoworkspacesilent, 3
bind = $mod SHIFT, 4, movetoworkspacesilent, 4
bind = $mod SHIFT, 5, movetoworkspacesilent, 5
bind = $mod SHIFT, 6, movetoworkspacesilent, 6
bind = $mod SHIFT, 7, movetoworkspacesilent, 7
bind = $mod SHIFT, 8, movetoworkspacesilent, 8
bind = $mod SHIFT, 9, movetoworkspacesilent, 9
bind = $mod SHIFT, 0, movetoworkspacesilent, 10

bind = $mod, F, fullscreen

# Float and scratchpad
bind = $mod SHIFT, SPACE, togglefloating
bind = $mod SHIFT, MINUS, movetoworkspacesilent, special:scratchpad
bind = $mod, MINUS, togglespecialworkspace, scratchpad

# Moving and resizing with mouse
bindm = $mod, mouse:272, movewindow
bindm = $mod, mouse:273, resizewindow

# Resizing mode
bind = $mod, R, submap, resize
submap = resize
binde = , LEFT, resizeactive, -10 0
binde = , DOWN, resizeactive, 0 10
binde = , UP, resizeactive, 0 -10
binde = , RIGHT, resizeactive, 10 0
binde = , H, resizeactive, -10 0
binde = , J, resizeactive, 0 10
binde = , K, resizeactive, 0 -10
binde = , L, resizeactive, 10 0
bind = , RETURN, submap, reset
bind = , ESCAPE, submap, reset
submap = reset

# Session mode
bind = $mod SHIFT, E, submap, session
submap = session
bind = , L, exec, $lock
bind = , L, submap, reset
bind = , E, exec, uwsm stop
bind = , S, exec, systemctl suspend
bind = , S, submap, reset
bind = , R, exec, systemctl reboot
bind = , P, exec, systemctl poweroff
bind = , RETURN, submap, reset
bind = , ESCAPE, submap, reset
submap = reset

# Media controls
bindel = , XF86AudioRaiseVolume, exec, wpctl set-volume -l 1 @DEFAULT_AUDIO_SINK@ 5%+
bindel = , XF86AudioLowerVolume, exec, wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-
bindl = , XF86AudioMute, exec, wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle
bindl = , XF86AudioMicMute, exec, wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle
bindl = , XF86AudioPlay, exec, playerctl play-pause
bindl = , XF86AudioNext, exec, playerctl next
bindl = , XF86AudioPrev, exec, playerctl previous
bindel = , XF86MonBrightnessUp, exec, brightnessctl set +5%
bindel = , XF86MonBrightnessDown, exec, brightnessctl set 5%-

# Host modules can override generic monitor handling without replacing this file.
source = /etc/xdg/hypr/conf.d/*.conf
